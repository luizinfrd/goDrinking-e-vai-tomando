generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  nome           String
  email          String          @unique
  senha          String
  dataCriacao    DateTime        @default(now())
  // "usuario" ou "admin": só admin mantém o catálogo de bebidas e locais
  papel          String          @default("usuario")
  preferences    UserPreference?
  avaliacoes     Avaliacao[]
  favoritos      Favorito[]
  bebidasCriadas Bebida[]

  @@map("users") //mantém os nomes das tabelas em português no banco
}

model UserPreference {
  userId              String  @id
  // vetor atual usado pela recomendação (recalculado a cada avaliação)
  pesoDoce            Float   @default(0)
  pesoSeco            Float   @default(0)
  pesoCitrico         Float   @default(0)
  pesoEncorpado       Float   @default(0)
  // vetor informado no onboarding (base fixa para o recálculo)
  baseDoce            Float   @default(0)
  baseSeco            Float   @default(0)
  baseCitrico         Float   @default(0)
  baseEncorpado       Float   @default(0)
  onboardingConcluido Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Bebida {
  id                String        @id @default(uuid())
  nome              String
  tipo              String
  descricao         String?
  imagemUrl         String?
  atributoDoce      Float         @default(0)
  atributoSeco      Float         @default(0)
  atributoCitrico   Float         @default(0)
  atributoEncorpado Float         @default(0)
  notaMedia         Float         @default(0)
  criadoUser        Boolean       @default(false)
  // autor da sugestão (bebidas da comunidade); só ele ou um admin editam
  criadoPorId       String?
  criadoPor         User?         @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  // campos exclusivos de vinho (null se for drink)
  tipoVinho         String?
  uva               String?
  paisOrigem        String?
  // campos exclusivos de drink (null se for vinho)
  ingredientes      String?
  baseAlcoolica     String?
  // pratos que combinam (valores fixos validados na API)
  harmonizaCom      String[]      @default([])
  avaliacoes        Avaliacao[]
  locais            BebidaLocal[]
  favoritos         Favorito[]

  @@map("bebidas")
}

model Avaliacao {
  id                 String   @id @default(uuid())
  userId             String
  bebidaId           String
  nota               Int
  comentario         String?
  data               DateTime @default(now())
  // como o usuário percebeu a bebida (opcional, 0 a 1): comparado com os atributos declarados
  percebidoDoce      Float?
  percebidoSeco      Float?
  percebidoCitrico   Float?
  percebidoEncorpado Float?
  // diário de degustação: onde bebeu e foto do momento (opcionais)
  localId            String?
  fotoUrl            String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bebida             Bebida   @relation(fields: [bebidaId], references: [id], onDelete: Cascade)
  local              Local?   @relation(fields: [localId], references: [id], onDelete: SetNull)

  // cada usuário avalia uma bebida uma única vez (pode editar depois)
  @@unique([userId, bebidaId])
  @@index([bebidaId])
  @@map("avaliacoes")
}

model Local {
  id         String        @id @default(uuid())
  nome       String
  tipo       String? // bar, restaurante, adega...
  endereco   String?
  descricao  String?
  imagemUrl  String?
  latitude   Float?
  longitude  Float?
  // 1 ($) a 4 ($$$$), estimativa exibida como referência
  faixaPreco Int?
  bebidas    BebidaLocal[]
  avaliacoes Avaliacao[]

  @@map("locais")
}

model BebidaLocal {
  localId  String
  bebidaId String
  local    Local  @relation(fields: [localId], references: [id], onDelete: Cascade)
  bebida   Bebida @relation(fields: [bebidaId], references: [id], onDelete: Cascade)

  @@id([localId, bebidaId])
  @@index([bebidaId])
  @@map("bebidas_locais")
}

// lista "quero provar" do usuário
model Favorito {
  userId   String
  bebidaId String
  criadoEm DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bebida   Bebida   @relation(fields: [bebidaId], references: [id], onDelete: Cascade)

  @@id([userId, bebidaId])
  @@map("favoritos")
}
