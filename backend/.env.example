# backend/.env.example — copie para backend/.env
# banco (o docker-compose sobe um postgres com esses dados)
DATABASE_URL="postgresql://godrinking:godrinking@localhost:5432/godrinking?schema=public"

# autenticação
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN=7d

# servidor
PORT=3000
NODE_ENV=development
# origens do front permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
